{
  "name": "brightloop",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "vercel-build": "if [ \"$VERCEL_ENV\" = \"production\" ]; then npm run db:migrate; fi && next build",
    "db:reset": "tsx src/db/reset.ts && tsx src/db/seed.ts",
    "db:seed:big": "tsx src/db/big-seed.ts"
  },
  "dependencies": {
    "better-auth": "^1.7.14",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.1",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.66.0",
    "next": "16.4.3",
    "nodemailer": "^10.3.1",
    "postgres": "^4.0.0",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.13",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.9",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": "22.x"
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true
  }
}
