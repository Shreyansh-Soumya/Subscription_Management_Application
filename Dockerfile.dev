# Local development only. Production runs on Vercel.
# Debian rather than Alpine, because several dependencies ship prebuilt binaries for glibc.
FROM node:22-bookworm-slim

ENV NEXT_TELEMETRY_DISABLED=1

# Created here so the named volumes mounted over them belong to the node user, not root.
WORKDIR /app
RUN mkdir -p /app/node_modules /app/.next && chown -R node:node /app
USER node

CMD ["sh", "docker/dev-start.sh"]
